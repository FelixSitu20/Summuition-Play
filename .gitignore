# Output-only allowlist. The release audit remains authoritative.
*
!.gitignore
!README.md
!pages-workflow.example.yml
!site/
!site/index.html
!site/.nojekyll
!site/publication-manifest.json
!site/Build/
!site/Build/*.data.unityweb
!site/Build/*.framework.js.unityweb
!site/Build/*.loader.js
!site/Build/*.wasm.unityweb
!.github/
!.github/workflows/
!.github/workflows/pages.yml
# Public guest redirect only. Do not add Unity project files.
!redirect/
!redirect/index.html
!redirect/.nojekyll
!redirect/publication-manifest.json

# Approved direct-hosted guest build and release checks only.
!.gitattributes
!guest/
!guest/.nojekyll
!guest/index.html
!guest/robots.txt
!guest/publication-manifest.json
!guest/game/
!guest/game/index.html
!guest/game/Build/
!guest/game/Build/*.data.unityweb
!guest/game/Build/*.framework.js.unityweb
!guest/game/Build/*.loader.js
!guest/game/Build/*.wasm.unityweb
!tests/
!tests/display.test.cjs
!tests/verify-publication.py
